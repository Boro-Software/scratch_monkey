"""Reusable config editor panel for scratch-monkey GUI."""

from enaml.widgets.api import (
    Container, Label, PushButton, GroupBox, CheckBox, Field, VGroup, HGroup,
    ObjectCombo
)
from enaml.core.api import Conditional, Looper
from enaml.layout.api import hbox

from scratch_monkey.gui.views.dialogs.create_shared_dialog import CreateSharedDialog


enamldef ConfigEditorPanel(Container): editor:
    attr model
    attr available_shared : list = []
    attr app_model

    padding = 0

    GroupBox:
        title = "Configuration"

        VGroup:
            HGroup:
                padding = 0
                Label:
                    text = "Command:"
                Field:
                    text << (editor.model.cmd if editor.model else "")
                    text ::
                        if editor.model:
                            editor.model.cmd = text
                    submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']
                    tool_tip = "Shell command to run when entering the instance"

            HGroup:
                padding = 0
                Label:
                    text = "Home:"
                Field:
                    text << (editor.model.home if editor.model else "")
                    text ::
                        if editor.model:
                            editor.model.home = text
                    placeholder = "<instance>/home"
                    submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']
                    tool_tip = "Override default home path (default: <instance>/home)"

            CheckBox:
                text = "Wayland"
                checked << (editor.model.wayland if editor.model else False)
                toggled ::
                    if editor.model:
                        editor.model.wayland = checked
                tool_tip = "Forward Wayland display socket for GUI applications"

            CheckBox:
                text = "SSH Agent"
                checked << (editor.model.ssh if editor.model else False)
                toggled ::
                    if editor.model:
                        editor.model.ssh = checked
                tool_tip = "Forward SSH agent socket into the container"

            CheckBox:
                text = "Podman socket"
                checked << (editor.model.podman if editor.model else False)
                toggled ::
                    if editor.model:
                        editor.model.podman = checked
                tool_tip = "Share the host's rootless podman socket. Containers started inside run on the host with your user's privileges."

            CheckBox:
                text = "X11"
                checked << (editor.model.x11 if editor.model else False)
                toggled ::
                    if editor.model:
                        editor.model.x11 = checked
                        if checked and not editor.model.gpu:
                            editor.model.gpu = True
                tool_tip = "Forward X11 display socket and Xauthority for GUI applications. Automatically enables GPU passthrough."

            CheckBox:
                text = "Overlay mode"
                checked << (editor.model.overlay if editor.model else False)
                toggled ::
                    if editor.model:
                        editor.model.overlay = checked
                tool_tip = "Run a persistent overlay container instead of a fresh one each time"

            Conditional:
                condition << (editor.model.overlay and editor.model.is_fedora if editor.model else False)

                CheckBox:
                    text = "Passwordless sudo"
                    checked << (editor.model.sudo if editor.model else True)
                    toggled ::
                        if editor.model:
                            editor.model.sudo = checked
                    tool_tip = "Grant passwordless sudo in the overlay container (takes effect on next overlay reset)"

            CheckBox:
                text = "GPU Passthrough"
                checked << (editor.model.gpu if editor.model else False)
                toggled ::
                    if editor.model:
                        editor.model.gpu = checked
                tool_tip = "Auto-detect and pass through GPU devices (/dev/dri, /dev/kfd, /dev/nvidia*)"

    GroupBox:
        title = "Volume Mounts"

        VGroup:
            Looper:
                iterable << (list(range(len(editor.model.volume_entries))) if editor.model else [])

                Container:
                    padding = 0
                    # Equal-width path fields: an HGroup gives the solver no
                    # relationship between the two stretchy Fields, so one hogs the
                    # width. See UI_LAYOUT.md ("Paired fields share width").
                    constraints = [
                        hbox(host_field, container_field, mode_combo, remove_btn),
                        host_field.width == container_field.width,
                    ]
                    Field: host_field:
                        hug_width = 'ignore'
                        minimum_size = (150, 0)
                        text << (editor.model.volume_entries[loop.item].host_path if editor.model and loop.item < len(editor.model.volume_entries) else "")
                        text ::
                            if editor.model and loop.item < len(editor.model.volume_entries):
                                editor.model.volume_entries[loop.item].host_path = text
                                editor.model.check_dirty()
                        placeholder = "Host path"
                        submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']

                    Field: container_field:
                        hug_width = 'ignore'
                        minimum_size = (150, 0)
                        text << (editor.model.volume_entries[loop.item].container_path if editor.model and loop.item < len(editor.model.volume_entries) else "")
                        text ::
                            if editor.model and loop.item < len(editor.model.volume_entries):
                                editor.model.volume_entries[loop.item].container_path = text
                                editor.model.check_dirty()
                        placeholder = "Container path"
                        submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']

                    ObjectCombo: mode_combo:
                        items = ["ro", "rw", "overlay"]
                        tool_tip = (
                            "ro: read-only, the container cannot change the host directory.\n"
                            "rw: read-write, changes go straight to the host directory.\n"
                            "overlay: the container sees a writable copy; changes are kept "
                            "per instance (they survive restarts and refresh) and the host "
                            "directory is never modified. Discard them with "
                            "'scratch-monkey reset-overlays'."
                        )
                        selected << (editor.model.volume_entries[loop.item].mode if editor.model and loop.item < len(editor.model.volume_entries) else "ro")
                        selected ::
                            if editor.model and loop.item < len(editor.model.volume_entries):
                                editor.model.volume_entries[loop.item].mode = selected
                                editor.model.check_dirty()

                    PushButton: remove_btn:
                        text = "\u2717"
                        minimum_size = (30, 0)
                        maximum_size = (30, 16777215)
                        clicked ::
                            if editor.model:
                                editor.model.remove_volume_entry(loop.item)

            PushButton:
                text = "+ Add Volume Mount"
                clicked ::
                    if editor.model:
                        editor.model.add_volume_entry()
                tool_tip = "Mount a host directory into the container"

    GroupBox:
        title = "Environment Variables"

        VGroup:
            Looper:
                iterable << (list(range(len(editor.model.env_vars))) if editor.model else [])

                HGroup:
                    align_widths = False
                    padding = 0
                    Field:
                        hug_width = 'ignore'
                        maximum_size = (150, 16777215)
                        text << (editor.model.env_vars[loop.item].split("=", 1)[0] if editor.model and loop.item < len(editor.model.env_vars) else "")
                        text ::
                            if editor.model and loop.item < len(editor.model.env_vars):
                                old = editor.model.env_vars[loop.item]
                                val = old.split("=", 1)[1] if "=" in old else ""
                                entries = list(editor.model.env_vars)
                                entries[loop.item] = text + "=" + val
                                editor.model.env_vars = entries
                                editor.model.check_dirty()
                        placeholder = "KEY"
                        submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']

                    Field:
                        hug_width = 'ignore'
                        text << (editor.model.env_vars[loop.item].split("=", 1)[1] if editor.model and loop.item < len(editor.model.env_vars) and "=" in editor.model.env_vars[loop.item] else "")
                        text ::
                            if editor.model and loop.item < len(editor.model.env_vars):
                                old = editor.model.env_vars[loop.item]
                                key = old.split("=", 1)[0] if "=" in old else old
                                entries = list(editor.model.env_vars)
                                entries[loop.item] = key + "=" + text
                                editor.model.env_vars = entries
                                editor.model.check_dirty()
                        placeholder = "value"
                        submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']

                    PushButton:
                        text = "\u2717"
                        minimum_size = (30, 0)
                        maximum_size = (30, 16777215)
                        clicked ::
                            if editor.model:
                                editor.model.remove_env_var(loop.item)

            PushButton:
                text = "+ Add Environment Variable"
                clicked ::
                    if editor.model:
                        editor.model.add_env_var()
                tool_tip = "Add a KEY=value environment variable"

    GroupBox:
        title = "Devices"

        VGroup:
            Looper:
                iterable << (list(range(len(editor.model.devices))) if editor.model else [])

                HGroup:
                    align_widths = False
                    padding = 0
                    Field:
                        hug_width = 'ignore'
                        text << (editor.model.devices[loop.item] if editor.model and loop.item < len(editor.model.devices) else "")
                        text ::
                            if editor.model and loop.item < len(editor.model.devices):
                                entries = list(editor.model.devices)
                                entries[loop.item] = text
                                editor.model.devices = entries
                                editor.model.check_dirty()
                        placeholder = "/dev/bus/usb"
                        submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']

                    PushButton:
                        text = "\u2717"
                        minimum_size = (30, 0)
                        maximum_size = (30, 16777215)
                        clicked ::
                            if editor.model:
                                entries = list(editor.model.devices)
                                if 0 <= loop.item < len(entries):
                                    del entries[loop.item]
                                    editor.model.devices = entries

            PushButton:
                text = "+ Add Device"
                clicked ::
                    if editor.model:
                        editor.model.devices = [*editor.model.devices, ""]
                tool_tip = "Pass through a host device (e.g. /dev/video0)"

    GroupBox:
        title = "Shared Volumes"

        VGroup:
            Conditional:
                condition << (len(editor.available_shared) == 0)

                Label:
                    text = "No shared volumes found."

            Conditional:
                condition << (len(editor.available_shared) > 0)

                Looper:
                    iterable << (list(range(len(editor.model.shared_entries))) if editor.model else [])

                    HGroup:
                        padding = 0
                        CheckBox:
                            text << (editor.model.shared_entries[loop.item].name if editor.model and loop.item < len(editor.model.shared_entries) else "")
                            checked << (editor.model.shared_entries[loop.item].enabled if editor.model and loop.item < len(editor.model.shared_entries) else False)
                            toggled ::
                                if editor.model and loop.item < len(editor.model.shared_entries):
                                    editor.model.shared_entries[loop.item].enabled = checked
                                    editor.model.check_dirty()

                        ObjectCombo:
                            items = ["rw", "ro"]
                            selected << (editor.model.shared_entries[loop.item].mode if editor.model and loop.item < len(editor.model.shared_entries) else "rw")
                            selected ::
                                if editor.model and loop.item < len(editor.model.shared_entries):
                                    editor.model.shared_entries[loop.item].mode = selected
                                    editor.model.check_dirty()
                            enabled << (editor.model.shared_entries[loop.item].enabled if editor.model and loop.item < len(editor.model.shared_entries) else False)

            PushButton:
                text = "+ New Shared Volume"
                clicked ::
                    if editor.app_model:
                        dlg = CreateSharedDialog(editor, app_model=editor.app_model)
                        dlg.exec_()
                tool_tip = "Create a new named volume shared across instances"
