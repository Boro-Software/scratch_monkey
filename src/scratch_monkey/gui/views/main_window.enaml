"""Main application window for scratch-monkey GUI."""

import enaml
with enaml.imports():
    from enaml.stdlib.message_box import question
from enaml.stdlib.dialog_buttons import DialogButton

from enaml.widgets.api import (
    MainWindow, Container, Label, ToolBar, Action, Splitter, SplitItem, ProgressBar, HGroup,
    PushButton
)
from enaml.layout.api import vbox, hbox
from enaml.styling import StyleSheet, Style, Setter

from scratch_monkey.gui.views.instance_list import InstanceListPanel
from scratch_monkey.gui.views.instance_detail import InstanceDetailPanel
from scratch_monkey.gui.views.dialogs.create_instance_dialog import CreateInstanceDialog
from scratch_monkey.gui.views.dialogs.banner_details_dialog import BannerDetailsDialog


enamldef ScratchMonkeyWindow(MainWindow): win:
    attr app_model

    title = "scratch-monkey"
    initial_size = (1200, 900)
    minimum_size = (900, 600)

    StyleSheet:
        Style:
            style_class = "error-banner"
            Setter:
                field = "background"
                value = "#c62828"
            Setter:
                field = "color"
                value = "#ffffff"
        Style:
            style_class = "warning-banner"
            Setter:
                field = "background"
                value = "#ffb300"
            Setter:
                field = "color"
                value = "#212121"

    closing ::
        if app_model.has_unsaved_changes():
            result = question(
                win,
                "Unsaved Changes",
                "Some instances have unsaved config changes. Close anyway?",
                [DialogButton('Close', 'accept'), DialogButton('Cancel', 'reject')],
            )
            if result is None or result.action != 'accept':
                change['value'].ignore()

    ToolBar:
        Action:
            text = "New Instance"
            enabled << not app_model.busy
            triggered ::
                dlg = CreateInstanceDialog(win, app_model=app_model, instance_model=app_model.new_instance_model())
                dlg.exec_()

        Action:
            text = "Refresh"
            enabled << not app_model.busy
            triggered ::
                app_model.refresh_async()

    Container:
        constraints = [
            vbox(banner, splitter, status_bar)
        ]

        HGroup: banner:
            # `banner` is named directly in the outer vbox(), so — per the
            # status_bar fix above — its height must be a deterministic
            # function of state rather than left to implicit hidden-widget
            # sizing, or toggling it can make the constraint solver resize
            # the Splitter unpredictably. Here we pin the height explicitly
            # to 0 when there's no message and to 32 when there is, instead of
            # relying on `visible` alone to collapse it.
            #
            # It shows one message at a time (app_model.banner_*): an error
            # (red) wins over a warning (amber). The label holds a single
            # elided line; "Details" (only when text was cut) opens the full
            # text, and the X button dismisses the message being shown.
            align_widths = False
            padding = 4
            trailing_spacer = None
            visible << bool(app_model.banner_level)
            minimum_size << (0, 32) if app_model.banner_level else (0, 0)
            maximum_size << (16777215, 32) if app_model.banner_level else (16777215, 0)
            Label: banner_label:
                text << app_model.banner_summary
                style_class << "error-banner" if app_model.banner_level == "error" else "warning-banner"
                hug_width = 'ignore'
            PushButton: details_btn:
                text = "Details"
                visible << app_model.banner_truncated
                minimum_size = (70, 0)
                maximum_size = (70, 24)
                clicked ::
                    dlg = BannerDetailsDialog(
                        win,
                        text=app_model.banner_text,
                        level=app_model.banner_level,
                    )
                    dlg.exec_()
            PushButton: dismiss_btn:
                text = "\u2715"
                tool_tip = "Dismiss"
                minimum_size = (30, 0)
                maximum_size = (30, 24)
                clicked :: app_model.dismiss_banner()

        Splitter: splitter:
            enabled << not app_model.busy
            SplitItem:
                stretch = 0
                InstanceListPanel:
                    app_model = win.app_model

            SplitItem:
                stretch = 1
                InstanceDetailPanel:
                    app_model = win.app_model

        HGroup: status_bar:
            align_widths = False
            padding = 0
            trailing_spacer = None
            minimum_size = (0, 28)
            maximum_size = (16777215, 28)
            ProgressBar: progress:
                visible << app_model.busy
                minimum = 0
                maximum = 0
                minimum_size = (120, 0)
                maximum_size = (120, 16777215)
            Label: status:
                text << app_model.status_message
