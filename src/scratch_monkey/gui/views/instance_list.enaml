"""Instance list panel for scratch-monkey GUI."""

import enaml
with enaml.imports():
    from enaml.stdlib.message_box import question
from enaml.stdlib.dialog_buttons import DialogButton

from enaml.widgets.api import Container, Dialog, Field, HGroup, Label, PushButton, ScrollArea, VGroup
from enaml.layout.api import vbox
from enaml.core.api import Looper
from enaml.styling import StyleSheet, Style, Setter

from scratch_monkey.gui.dialog_helpers import make_on_done, start_working
from scratch_monkey.gui.views.create_dialog import CreateInstanceDialog


enamldef RenameDialog(Dialog): dlg:
    attr app_model
    attr instance_name : str = ""
    attr _error_msg : str = ""
    attr working : bool = False

    title = "Rename Instance"

    closing ::
        # Don't let the user dismiss the dialog while the action is in flight.
        if dlg.working:
            change['value'].ignore()

    Container:
        enabled << not dlg.working
        VGroup:
            Label:
                text << f"Rename '{dlg.instance_name}' to:"
            Field: name_field:
                text = dlg.instance_name
                placeholder = "new-name"
                submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']
            Label: error_label:
                text << dlg._error_msg
                visible << bool(dlg._error_msg)
            Label: working_label:
                text = "Working..."
                visible << dlg.working
            HGroup:
                PushButton:
                    text = "Rename"
                    enabled << bool(name_field.text.strip()) and name_field.text.strip() != dlg.instance_name
                    clicked ::
                        start_working(dlg)
                        dlg.app_model.rename_instance(dlg.instance_name, name_field.text.strip(), make_on_done(dlg))
                PushButton:
                    text = "Cancel"
                    clicked ::
                        dlg.close()


enamldef CloneDialog(Dialog): dlg:
    attr app_model
    attr instance_name : str = ""
    attr _error_msg : str = ""
    attr working : bool = False

    title = "Clone Instance"

    closing ::
        # Don't let the user dismiss the dialog while the action is in flight.
        if dlg.working:
            change['value'].ignore()

    Container:
        enabled << not dlg.working
        VGroup:
            Label:
                text << f"Clone '{dlg.instance_name}' as:"
            Field: name_field:
                placeholder << f"{dlg.instance_name}-copy"
                submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']
            Label: error_label:
                text << dlg._error_msg
                visible << bool(dlg._error_msg)
            Label: working_label:
                text = "Working..."
                visible << dlg.working
            HGroup:
                PushButton:
                    text = "Clone"
                    enabled << bool(name_field.text.strip())
                    clicked ::
                        start_working(dlg)
                        dlg.app_model.clone_instance(dlg.instance_name, name_field.text.strip(), make_on_done(dlg))
                PushButton:
                    text = "Cancel"
                    clicked ::
                        dlg.close()


enamldef InstanceListPanel(Container): panel:
    attr app_model
    minimum_size = (350, 0)

    StyleSheet:
        Style:
            style_class = "status-running"
            Setter:
                field = "color"
                value = "#22aa22"
        Style:
            style_class = "status-stopped"
            Setter:
                field = "color"
                value = "#cc2222"
        Style:
            style_class = "status-unknown"
            Setter:
                field = "color"
                value = "#cc8800"

    constraints = [vbox(scroll, new_btn)]

    ScrollArea: scroll:
        VGroup:
            spacing = 2
            Looper:
                iterable << app_model.instances
                HGroup:
                    attr inst = loop_item
                    align_widths = False
                    padding = 0
                    spacing = 2
                    PushButton:
                        checkable = True
                        checked << inst.overlay_running
                        # status_error set => podman could not be queried (e.g. stuck
                        # container lock): show "unknown", not a misleading "stopped".
                        text << ("?" if inst.status_error else "\u25CF")
                        style_class << ("status-unknown" if inst.status_error else ("status-running" if inst.overlay_running else "status-stopped"))
                        tool_tip << (("Status unknown: " + inst.status_error) if inst.status_error else ("Running — click to stop" if inst.overlay_running else "Stopped"))
                        minimum_size = (24, 0)
                        maximum_size = (24, 16777215)
                        toggled ::
                            if checked and not inst.overlay_running:
                                app_model.start_instance(inst.name)
                            elif not checked and inst.overlay_running:
                                app_model.stop_instance(inst.name)
                    Label:
                        text << ("F" if "fedora" in (inst.base_image or "").lower() else "\u2013")
                        tool_tip << (inst.base_image if inst.base_image and "fedora" in inst.base_image.lower() else "Scratch")
                        minimum_size = (16, 0)
                        maximum_size = (16, 16777215)
                    PushButton: btn:
                        checkable = True
                        checked << (app_model.selected_instance == inst.name)
                        hug_width = 'ignore'
                        text << inst.name
                        clicked ::
                            proceed = True
                            if app_model.selected and app_model.selected.dirty:
                                result = question(
                                    panel,
                                    "Unsaved Changes",
                                    f"Instance '{app_model.selected_instance}' has unsaved changes. Discard them?",
                                    [DialogButton('Discard', 'accept'), DialogButton('Cancel', 'reject')],
                                )
                                proceed = result is not None and result.action == 'accept'
                            if proceed:
                                app_model.selected_instance = inst.name

                    PushButton:
                        text = "\u29C9"
                        minimum_size = (30, 0)
                        maximum_size = (30, 16777215)
                        tool_tip = "Clone this instance"
                        clicked ::
                            dlg = CloneDialog(panel, app_model=app_model, instance_name=inst.name)
                            dlg.exec_()

                    PushButton:
                        text = "\u270E"
                        minimum_size = (30, 0)
                        maximum_size = (30, 16777215)
                        tool_tip = "Rename this instance"
                        clicked ::
                            dlg = RenameDialog(panel, app_model=app_model, instance_name=inst.name)
                            dlg.exec_()

                    PushButton:
                        text = "\u2717"
                        minimum_size = (30, 0)
                        maximum_size = (30, 16777215)
                        tool_tip = "Delete this instance"
                        clicked ::
                            result = question(
                                panel,
                                "Delete Instance",
                                f"Delete instance '{inst.name}' and all its data?",
                                [DialogButton('Delete', 'accept'), DialogButton('Cancel', 'reject')],
                            )
                            if result is not None and result.action == 'accept':
                                app_model.delete_instance(inst.name)

    PushButton: new_btn:
        text = "+ New Instance"
        clicked ::
            dlg = CreateInstanceDialog(panel, app_model=app_model, instance_model=app_model.new_instance_model())
            dlg.exec_()
