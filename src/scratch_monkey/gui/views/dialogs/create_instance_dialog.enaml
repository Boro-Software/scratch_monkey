"""Create Instance dialog for scratch-monkey GUI."""

from enaml.widgets.api import Dialog, Container, Label, Field, CheckBox, PushButton, HGroup, VGroup

from scratch_monkey.gui.views.config_editor import ConfigEditorPanel
from scratch_monkey.gui.dialog_helpers import make_on_done, start_working


enamldef CreateInstanceDialog(Dialog): dlg:
    attr app_model
    attr instance_model
    attr _error_msg : str = ""
    attr working : bool = False

    title = "Create Instance"

    closing ::
        # Don't let the user dismiss the dialog while the action is in flight.
        if dlg.working:
            change['value'].ignore()

    Container:
        enabled << not dlg.working
        VGroup:
            Label:
                text = "Instance Name (required):"

            Field: name_field:
                placeholder = "my-instance"
                submit_triggers = ['lost_focus', 'return_pressed', 'auto_sync']
                tool_tip = "Unique name (letters, numbers, and hyphens)"

            CheckBox: fedora_cb:
                text = "Fedora base image"
                tool_tip = "Use a Fedora base image instead of scratch"

            CheckBox: skel_cb:
                text = "Copy /etc/skel"
                tool_tip = "Copy skeleton files into the home directory"

            ConfigEditorPanel:
                model = dlg.instance_model
                available_shared << dlg.app_model.available_shared if dlg.app_model else []
                app_model = dlg.app_model

            Label: error_label:
                text << dlg._error_msg
                visible << bool(dlg._error_msg)

            Label: working_label:
                text = "Working..."
                visible << dlg.working

            HGroup:
                PushButton:
                    text = "Create"
                    enabled << bool(name_field.text.strip())
                    clicked ::
                        cfg = dlg.instance_model.to_config() if dlg.instance_model else None
                        start_working(dlg)
                        app_model.create_instance(
                            name_field.text.strip(),
                            make_on_done(dlg),
                            fedora=fedora_cb.checked,
                            skel=skel_cb.checked,
                            config=cfg,
                        )

                PushButton:
                    text = "Cancel"
                    clicked ::
                        dlg.close()
